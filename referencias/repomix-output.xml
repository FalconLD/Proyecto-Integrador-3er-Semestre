<file path="app/Models/StudentRegistration.php">
<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;
use App\Models\Career;

class StudentRegistration extends Model
{
    use HasFactory;

    // Estados del campo 'tomado'
    const STUDENT_CAN_TAKE_SHIFT = 0;        // Puede tomar turno
    const STUDENT_HAS_SHIFT = 1;             // Tiene turno (puede eliminar)
    const STUDENT_DELETED_CAN_REBOOK = 2;    // Eliminó, puede reagendar
    const STUDENT_REBOOKED_FINAL = 3;        // Reagendó, turno FINAL (no puede eliminar)


    protected $fillable = [
        'names',
        'cedula',
        'banner_id',
        // 'edad',
        // 'fecha_nacimiento',
        'telefono',
        'direccion',
        'correo_puce',
        'facultad',
        'carrera',
        'nivel',
        'plan_estudio',
        'motivo',
        'nivel_instruccion',
        'acepta_terminos',
        'tomado', // 0, 1, 2, o 3
    ];

    // Relación con turnos
    public function shifts()
    {
        return $this->hasMany(Shift::class, 'person_shift', 'cedula');
    }

    // Scope: estudiantes con turnos pasados OCUPADOS
    public function scopeWithPastOccupiedShifts($query)
    {
        return $query->whereHas('shifts', function ($q) {
            $q->where('date_shift', '<', now())
                ->where('status_shift', Shift::STATUS_OCCUPIED);
        });
    }

    // ¿Está bloqueado por turno pasado?
    public function isBlockedByPastShift()
    {
        return $this->shifts()
            ->where('date_shift', '<', now())
            ->where('status_shift', Shift::STATUS_OCCUPIED)
            ->exists();
    }

    // ¿Está en estado final (tomado = 3)?
    public function isFinalState()
    {
        return $this->tomado == self::STUDENT_REBOOKED_FINAL;
    }
    public function career()
    {
        return $this->belongsTo(Career::class, 'plan_estudio', 'career_code');
    }
}
