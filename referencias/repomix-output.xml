<file path="database/seeders/CubiculoSeeder.php">
<?php

namespace Database\Seeders;

use Illuminate\Database\Seeder;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Str;
use Carbon\Carbon;
use App\Models\User;

class CubiculoSeeder extends Seeder
{
    private $chunkSize = 100;
    private $diasTotales = 15;      // 5 pasados + 10 futuros
    private $diasPasados = 5;
    private $now;

    public function run(): void
    {
        $this->now = now();
        $this->command->info('🚀 Iniciando CubiculoSeeder...');

        $this->truncarTablas();

        // Obtener asignaciones operador-área
        $assignments = DB::table('area_user')->get();

        if ($assignments->isEmpty()) {
            $this->command->warn('⚠️ No hay asignaciones. Creando por defecto...');
            $assignments = $this->crearAsignacionesPorDefecto();
        }

        $allCubiculos = $allSchedules = $allBreaks = $allDays = [];
        $allCubiculoSchedules = $allShifts = [];
        $scheduleIdCounter = DB::table('schedules')->max('id_hor') ?? 0;
        $cubiculosPorAsignacion = 2; // Ajustable

        foreach ($assignments as $assignment) {
            for ($i = 1; $i <= $cubiculosPorAsignacion; $i++) {
                $cubiculoId = $this->getNextCubiculoId();
                $scheduleId = ++$scheduleIdCounter;

                // 1. Cubículo
                $allCubiculos[] = [
                    'nombre' => 'C-' . str_pad($cubiculoId, 3, '0', STR_PAD_LEFT),
                    'tipo_atencion' => 'virtual',
                    'enlace_o_ubicacion' => 'https://teams.microsoft.com/l/meetup-join/puce-session-' . $cubiculoId,
                    'user_id' => $assignment->user_id,
                    'operating_area_id' => $assignment->operating_area_id,
                    'created_at' => $this->now,
                    'updated_at' => $this->now,
                ];

                // 2. Horario
                $allSchedules[] = [
                    'id_hor' => $scheduleId,
                    'start_time' => '08:00:00',
                    'end_time' => '17:00:00',
                    'valid_from' => Carbon::today()->subDays($this->diasPasados)->format('Y-m-d'),
                    'break_minutes' => 0,
                    'attention_minutes' => 15,
                    'created_at' => $this->now,
                    'updated_at' => $this->now,
                ];

                // 3. Receso
                $allBreaks[] = [
                    'schedule_id' => $scheduleId,
                    'start_break' => '13:00:00',
                    'end_break' => '14:00:00',
                    'created_at' => $this->now,
                    'updated_at' => $this->now,
                ];

                // 4. Días laborables
                $allDays = array_merge($allDays, $this->generarDiasParaSchedule($scheduleId));

                // 5. Relación cubículo-horario
                $allCubiculoSchedules[] = [
                    'cubiculo_id' => $cubiculoId,
                    'schedule_id' => $scheduleId,
                    'created_at' => $this->now,
                    'updated_at' => $this->now,
                ];

                // 6. Turnos
                $allShifts = array_merge($allShifts, $this->generarTurnosOptimizado(
                    $cubiculoId,
                    $scheduleId,
                    '08:00:00',
                    '17:00:00',
                    15,
                    [['start' => '13:00:00', 'end' => '14:00:00']]
                ));
            }
        }

        // Inserción masiva
        $this->insertarEnLote('cubiculos', $allCubiculos, 'Cubículos');
        $this->insertarEnLote('schedules', $allSchedules, 'Schedules');
        $this->insertarEnLote('schedule_breaks', $allBreaks, 'Breaks');
        $this->insertarEnLote('days', $allDays, 'Días', 200);
        $this->insertarEnLote('cubiculos_schedules', $allCubiculoSchedules, 'Relaciones');
        $this->insertarEnLote('shifts', $allShifts, 'Turnos', 200);

        $this->mostrarEstadisticasTurnos();
        $this->command->info('✅ CubiculoSeeder finalizado.');
    }

    private function getNextCubiculoId(): int
    {
        static $id = 0;
        return ++$id;
    }

    /**
     * Crea asignaciones por defecto (todos los operadores a todas las áreas).
     */
    private function crearAsignacionesPorDefecto(): array
    {
        $operadores = User::role('Operador')->get();
        if ($operadores->isEmpty()) {
            $this->command->error('❌ No hay operadores. Ejecuta UserSeeder primero.');
            return [];
        }

        $areas = DB::table('operating_areas')->get();
        if ($areas->isEmpty()) {
            $this->command->error('❌ No hay áreas operativas. Ejecuta OperatingAreaSeeder primero.');
            return [];
        }

        $assignments = [];
        foreach ($operadores as $operador) {
            foreach ($areas as $area) {
                DB::table('area_user')->updateOrInsert([
                    'user_id' => $operador->id,
                    'operating_area_id' => $area->id,
                ], ['created_at' => now(), 'updated_at' => now()]);

                $assignments[] = (object) [
                    'user_id' => $operador->id,
                    'operating_area_id' => $area->id,
                ];
            }
        }

        $this->command->info("✅ Asignaciones por defecto: " . count($assignments) . " registros.");
        return $assignments;
    }

    private function truncarTablas(): void
    {
        DB::statement('SET FOREIGN_KEY_CHECKS=0;');
        DB::table('shifts')->truncate();
        DB::table('schedule_breaks')->truncate();
        DB::table('cubiculos_schedules')->truncate();
        DB::table('days')->truncate();
        DB::table('schedules')->truncate();
        DB::table('cubiculos')->truncate();
        DB::statement('SET FOREIGN_KEY_CHECKS=1;');
    }

    private function generarDiasParaSchedule(int $scheduleId): array
    {
        $days = [];
        $fechaInicio = Carbon::today()->subDays($this->diasPasados);

        for ($dia = 0; $dia < $this->diasTotales; $dia++) {
            $fechaActual = $fechaInicio->copy()->addDays($dia);
            if (!$fechaActual->isWeekend()) {
                $days[] = [
                    'schedule_day' => $scheduleId,
                    'date_day' => $fechaActual->format('Y-m-d'),
                    'created_at' => $this->now,
                    'updated_at' => $this->now,
                ];
            }
        }
        return $days;
    }

    private function generarTurnosOptimizado(
        int $cubiculoId,
        int $scheduleId,
        string $horaInicio,
        string $horaFin,
        int $duracionMinutos,
        array $breaks
    ): array {
        $shifts = [];
        $fechaInicio = Carbon::today()->subDays($this->diasPasados);

        $breakObjects = [];
        foreach ($breaks as $break) {
            $breakObjects[] = [
                'start' => Carbon::parse($break['start']),
                'end' => Carbon::parse($break['end']),
            ];
        }

        for ($dia = 0; $dia < $this->diasTotales; $dia++) {
            $fechaActual = $fechaInicio->copy()->addDays($dia);
            if ($fechaActual->isWeekend()) continue;

            $horaActual = Carbon::parse($fechaActual->format('Y-m-d') . ' ' . $horaInicio);
            $horaLimite = Carbon::parse($fechaActual->format('Y-m-d') . ' ' . $horaFin);

            while ($horaActual->lt($horaLimite)) {
                $horaFinTurno = $horaActual->copy()->addMinutes($duracionMinutos);
                $enBreak = false;

                foreach ($breakObjects as $break) {
                    $breakStart = $fechaActual->copy()->setTime($break['start']->hour, $break['start']->minute, $break['start']->second);
                    $breakEnd = $fechaActual->copy()->setTime($break['end']->hour, $break['end']->minute, $break['end']->second);

                    if (
                        ($horaActual->gte($breakStart) && $horaFinTurno->lte($breakEnd)) ||
                        ($horaActual->gt($breakStart) && $horaActual->lt($breakEnd)) ||
                        ($horaFinTurno->gt($breakStart) && $horaFinTurno->lt($breakEnd)) ||
                        ($horaActual->lt($breakStart) && $horaFinTurno->gt($breakEnd))
                    ) {
                        $enBreak = true;
                        break;
                    }
                }

                if (!$enBreak && $horaFinTurno->lte($horaLimite)) {
                    $shifts[] = [
                        'id_shift' => Str::uuid()->toString(),
                        'schedule_shift' => $scheduleId,
                        'cubicle_shift' => $cubiculoId,
                        'date_shift' => $fechaActual->format('Y-m-d'),
                        'start_shift' => $horaActual->format('H:i:s'),
                        'end_shift' => $horaFinTurno->format('H:i:s'),
                        'person_shift' => null,
                        'status_shift' => 1,
                        'created_at' => $this->now,
                        'updated_at' => $this->now,
                    ];
                }

                $horaActual->addMinutes($duracionMinutos);

                // Saltar breaks
                foreach ($breakObjects as $break) {
                    $breakStart = $fechaActual->copy()->setTime($break['start']->hour, $break['start']->minute, $break['start']->second);
                    $breakEnd = $fechaActual->copy()->setTime($break['end']->hour, $break['end']->minute, $break['end']->second);
                    if ($horaActual->gt($breakStart) && $horaActual->lt($breakEnd)) {
                        $horaActual = $breakEnd->copy();
                    }
                }
            }
        }
        return $shifts;
    }

    private function insertarEnLote(string $tabla, array $datos, string $nombre, int $chunkSize = null): void
    {
        if (empty($datos)) return;

        $chunkSize = $chunkSize ?: $this->chunkSize;
        $total = count($datos);
        $this->command->info("   Insertando {$total} {$nombre}...");

        foreach (array_chunk($datos, $chunkSize) as $chunk) {
            DB::table($tabla)->insert($chunk);
        }
    }

    private function mostrarEstadisticasTurnos(): void
    {
        $today = Carbon::today();
        $turnosPasados = DB::table('shifts')->where('date_shift', '<', $today)->count();
        $turnosHoy = DB::table('shifts')->where('date_shift', '=', $today)->count();
        $turnosFuturos = DB::table('shifts')->where('date_shift', '>', $today)->count();
        $turnosAsignados = DB::table('shifts')->whereNotNull('person_shift')->count();

        $this->command->info("📊 Turnos generados: Pasados {$turnosPasados} | Hoy {$turnosHoy} | Futuros {$turnosFuturos} | Asignados {$turnosAsignados}");
    }
}
