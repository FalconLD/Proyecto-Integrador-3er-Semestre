<?php

namespace Database\Seeders;

use App\Models\StudentRegistration;
use Illuminate\Database\Seeder;
use Illuminate\Support\Facades\DB;
use Carbon\Carbon;
use Illuminate\Support\Facades\File;
use Illuminate\Support\Str;

class StudentRegistrationSeeder extends Seeder
{
    private $faker;
    private $careers;
    private $habitatCareers = [];
    private $generatedEmails = [];
    private $generatedCedulas = [];
    private $generatedBannerIds = [];

    public function __construct()
    {
        $this->faker = \Faker\Factory::create('es_EC');
        $careersPath = database_path('data/careers.json');
        $this->careers = File::exists($careersPath)
            ? json_decode(File::get($careersPath), true)
            : $this->getDefaultCareers();

        // Filtrar carreras de la facultad de Hábitat
        $this->habitatCareers = array_filter(
            $this->careers,
            fn($c) => str_contains($c['area_name'] ?? '', 'Hábitat, Infraestructura Y Creatividad')
        );
    }

    public function run(): void
    {
        $this->command->info('🚀 Iniciando StudentRegistrationSeeder...');
        $this->limpiarTablaEstudiantes();

        $students = [];

        // 5 estudiantes de Hábitat
        for ($i = 1; $i <= 5; $i++) {
            $students[] = $this->generateStudent(true, $i);
        }

        // 5 estudiantes de otras facultades
        for ($i = 6; $i <= 10; $i++) {
            $students[] = $this->generateStudent(false, $i);
        }

        DB::table('student_registrations')->insert($students);
        $this->command->info("✅ 10 estudiantes insertados.");

        $this->assignPastShifts();
        $this->showStatistics();
    }

    private function limpiarTablaEstudiantes(): void
    {
        DB::table('shifts')->whereNotNull('person_shift')->update(['person_shift' => null]);
        DB::statement('SET FOREIGN_KEY_CHECKS=0;');
        DB::table('student_registrations')->truncate();
        DB::statement('SET FOREIGN_KEY_CHECKS=1;');
    }

    private function generateStudent(bool $isHabitat, int $index): array
    {
        $career = $this->selectCareer($isHabitat);
        $cedula = $this->generateUniqueCedula($index);
        $bannerId = $this->generateBannerId($index);
        $firstName = $this->faker->firstName();
        $lastName = $this->faker->lastName() . ' ' . $this->faker->lastName();

        return [
            'names' => $firstName . ' ' . $lastName,
            'cedula' => $cedula,
            'banner_id' => $bannerId,
            'telefono' => '09' . $this->faker->numerify('#######'),
            'direccion' => $this->faker->address(),
            'correo_puce' => $this->generateUniquePuceEmail($firstName, $lastName),
            'facultad' => $career['area_name'] ?? 'Facultad no especificada',
            'carrera' => $career['name'] ?? 'Carrera no especificada',
            'nivel' => $this->getRandomLevel(),
            'plan_estudio' => $career['career_code'] ?? 'Q' . rand(100, 999),
            'motivo' => $this->getRandomReason(),
            'nivel_instruccion' => 'grado',
            'tomado' => $this->determineShiftStatus($index),
            'acepta_terminos' => true,
            'created_at' => Carbon::now()->subDays(rand(0, 60)),
            'updated_at' => Carbon::now(),
        ];
    }

    private function selectCareer(bool $isHabitat): array
    {
        $candidates = $isHabitat ? $this->habitatCareers : $this->careers;
        // Filtrar carreras con código válido (evitar "No existe programa")
        $validos = array_filter($candidates, fn($c) => !str_contains($c['career_code'] ?? '', 'No existe'));
        return $this->faker->randomElement($validos ?: $candidates);
    }

    // Generadores de datos únicos
    private function generateUniqueCedula(int $index): string
    {
        do {
            $cedula = (string) (1724000000 + ($index * 1000) + rand(1, 999));
        } while (in_array($cedula, $this->generatedCedulas));
        $this->generatedCedulas[] = $cedula;
        return $cedula;
    }

    private function generateBannerId(int $index): string
    {
        do {
            $bannerId = '00' . str_pad($index * 1000 + rand(1, 999), 7, '0', STR_PAD_LEFT);
        } while (in_array($bannerId, $this->generatedBannerIds));
        $this->generatedBannerIds[] = $bannerId;
        return $bannerId;
    }

    private function generateUniquePuceEmail(string $firstName, string $lastName): string
    {
        do {
            $initials = strtolower(substr($firstName, 0, 1));
            $lastNameParts = explode(' ', $lastName);
            $lastNameClean = preg_replace('/[^a-z]/', '', strtolower($lastNameParts[0]));
            $randomNum = rand(10, 99);
            $email = $initials . substr($lastNameClean, 0, 4) . $randomNum . '@puce.edu.ec';
        } while (in_array($email, $this->generatedEmails));
        $this->generatedEmails[] = $email;
        return $email;
    }

    /**
     * Determina el estado del estudiante (0-3) según índice para variedad.
     */
    private function determineShiftStatus(int $index): int
    {
        if ($index <= 7) {
            return $this->faker->randomElement([
                StudentRegistration::STUDENT_HAS_SHIFT,
                StudentRegistration::STUDENT_REBOOKED_FINAL
            ]);
        }
        return $this->faker->randomElement([
            StudentRegistration::STUDENT_CAN_TAKE_SHIFT,
            StudentRegistration::STUDENT_DELETED_CAN_REBOOK
        ]);
    }

    private function getRandomLevel(): string
    {
        $niveles = ['1er Semestre', '2do Semestre', '3er Semestre', '4to Semestre',
                   '5to Semestre', '6to Semestre', '7mo Semestre', '8vo Semestre',
                   '9no Semestre', '10mo Semestre'];
        return $this->faker->randomElement($niveles);
    }

    private function getRandomReason(): string
    {
        $reasons = [
            'Consulta sobre requisitos de titulación',
            'Solicitud de certificado de notas virtual',
            'Problemas con el registro de materias',
            'Consulta sobre prácticas preprofesionales',
            'Solicitud de cambio de carrera',
            'Problemas con el pago de matrícula',
            'Consulta sobre becas y ayudas económicas',
            'Solicitud de convalidación de materias',
            'Problemas con la plataforma virtual',
            'Consulta sobre graduación y trámites finales',
        ];
        return $this->faker->randomElement($reasons);
    }

    /**
     * Asigna turnos pasados a estudiantes con estado 1 o 3,
     * respetando el área operativa de su carrera.
     */
    private function assignPastShifts(): void
    {
        $studentsWithShift = DB::table('student_registrations')
            ->whereIn('tomado', [StudentRegistration::STUDENT_HAS_SHIFT, StudentRegistration::STUDENT_REBOOKED_FINAL])
            ->get();

        $asignados = 0;

        foreach ($studentsWithShift as $student) {
            $career = DB::table('careers')->where('career_code', $student->plan_estudio)->first();
            if (!$career) continue;

            $cubiculosValidos = DB::table('cubiculos')
                ->whereNotNull('user_id')
                ->where('operating_area_id', $career->operating_area_id)
                ->pluck('id')
                ->toArray();

            if (empty($cubiculosValidos)) continue;

            $turno = DB::table('shifts')
                ->whereIn('cubicle_shift', $cubiculosValidos)
                ->where('person_shift', null)
                ->where('date_shift', '<', Carbon::today())
                ->orderBy('date_shift', 'asc')
                ->first();

            if (!$turno) {
                $turno = $this->createSinglePastShift($cubiculosValidos[array_rand($cubiculosValidos)]);
            }

            if ($turno) {
                DB::table('shifts')->where('id_shift', $turno->id_shift)->update([
                    'person_shift' => $student->cedula,
                    'status_shift' => 0,
                    'updated_at' => Carbon::now(),
                ]);
                $asignados++;
            }
        }

        $this->command->info("📌 Turnos pasados asignados: {$asignados}");
    }

    /**
     * Crea un turno pasado en un cubículo específico.
     */
    private function createSinglePastShift(int $cubiculoId): ?object
    {
        $schedule = DB::table('schedules')->inRandomOrder()->first();
        if (!$schedule) return null;

        $date = Carbon::today()->subDays(rand(1, 10))->format('Y-m-d');
        $startHour = rand(8, 16);
        $startMinute = rand(0, 3) * 15;
        $startTime = sprintf('%02d:%02d:00', $startHour, $startMinute);
        $endTime = sprintf('%02d:%02d:00', $startHour, $startMinute + 15);
        $idShift = Str::uuid()->toString();

        DB::table('shifts')->insert([
            'id_shift' => $idShift,
            'schedule_shift' => $schedule->id_hor,
            'cubicle_shift' => $cubiculoId,
            'date_shift' => $date,
            'start_shift' => $startTime,
            'end_shift' => $endTime,
            'person_shift' => null,
            'status_shift' => 1,
            'created_at' => Carbon::now(),
            'updated_at' => Carbon::now(),
        ]);

        return DB::table('shifts')->where('id_shift', $idShift)->first();
    }

    private function getDefaultCareers(): array
    {
        return [
            ["career_code" => "Q323", "name" => "ARQUITECTURA", "area_name" => "Facultad De Hábitat, Infraestructura Y Creatividad"],
            ["career_code" => "Q324", "name" => "ARTES VISUALES", "area_name" => "Facultad De Hábitat, Infraestructura Y Creatividad"],
            // ... resto de carreras por defecto ...
        ];
    }

    private function showStatistics(): void
    {
        $total = DB::table('student_registrations')->count();
        $estados = [
            '0: Puede tomar turno' => StudentRegistration::STUDENT_CAN_TAKE_SHIFT,
            '1: Tiene turno' => StudentRegistration::STUDENT_HAS_SHIFT,
            '2: Eliminó (puede reagendar)' => StudentRegistration::STUDENT_DELETED_CAN_REBOOK,
            '3: Reagendó (final)' => StudentRegistration::STUDENT_REBOOKED_FINAL,
        ];

        $this->command->info("📊 Estadísticas: {$total} estudiantes.");
        foreach ($estados as $nombre => $valor) {
            $count = DB::table('student_registrations')->where('tomado', $valor)->count();
            $this->command->info("   {$nombre}: {$count}");
        }
    }
}
