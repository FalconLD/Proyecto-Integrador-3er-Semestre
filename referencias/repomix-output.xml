<file path="database/seeders/CareerSeeder.php">
<?php

namespace Database\Seeders;

use Illuminate\Database\Seeder;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\File;

class CareerSeeder extends Seeder
{
    public function run(): void
    {
        $jsonPath = database_path('data/careers.json');
        
        if (!File::exists($jsonPath)) {
            $this->command->error("Archivo no encontrado.");
            return;
        }

        $careersData = json_decode(File::get($jsonPath), true);
        $areasMap = DB::table('operating_areas')->pluck('id', 'name');

        $rows = [];
        foreach ($careersData as $item) {
            $areaId = $areasMap[$item['area_name']] ?? null;

            if ($areaId) {
                // EXPLICACIÓN: Cortamos el código por el separador " - "
                // Si el código es "Q334 - Q169", crea un array: ["Q334", "Q169"]
                $codes = explode(' - ', $item['career_code']);

                foreach ($codes as $individualCode) {
                    $rows[] = [
                        'career_code'       => trim($individualCode), // trim() quita espacios extra
                        'name'              => $item['name'], // "INGENIERIA EN GEOGRAFIA" ejemplo
                        'operating_area_id' => $areaId, // Facultad de Ciencias de la Tierra ejemplo
                        'created_at'        => now(),
                        'updated_at'        => now(),
                    ];
                }
            }
        }

        // Usamos upsert para insertar todo de golpe. 
        // Si el 'career_code' ya existe, solo actualiza los datos.
        DB::table('careers')->upsert($rows, ['career_code'], ['name', 'operating_area_id', 'updated_at']);
        
        $this->command->info("Proceso completado: Se generaron " . count($rows) . " registros individuales.");
    }
}
