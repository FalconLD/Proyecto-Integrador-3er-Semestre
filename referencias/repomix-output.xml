<file path="app/Http/Controllers/Admin/ShiftController.php">
<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Http\Requests\NewShift;
use App\Models\Schedule;
use App\Models\Shift;
use App\Models\StudentRegistration;
use Carbon\Carbon;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Log;

class ShiftController extends Controller
{
    /**
     * Almacena un nuevo turno vinculado a un estudiante.
     */
    public function store(NewShift $request)
    {
        $idNumber = $request['identification'];
        $email = $request['email'];

        // 1. Verificación de vigencia del horario maestro
        $schedule = Schedule::orderBy('valid_from', 'desc')->first();
        if ($schedule) {
            $today = Carbon::today();
            $validFrom = Carbon::parse($schedule->valid_from);

            if ($today->lt($validFrom)) {
                return response()->json([
                    'error' => true,
                    'message' => "Los turnos estarán disponibles a partir del " . $validFrom->format('d/m/Y') . "."
                ], 403);
            }
        }

        // 2. Buscar o crear el registro del estudiante (StudentRegistration)
        $person = StudentRegistration::where('cedula', $idNumber)
            ->orWhere('correo_puce', $email)
            ->first();

        if (!$person) {
            $person = new StudentRegistration();
            $person->cedula = $idNumber;
            $person->correo_puce = $email;
            $person->names = $request['names'] ?? 'Estudiante Nuevo';
            $person->telefono = $request['phone'] ?? '0000000000';
            $person->direccion = $request['address'] ?? 'N/A';
            $person->edad = $request['age'] ?? 18;
            $person->fecha_nacimiento = $request['birthdate'] ?? now();
            $person->facultad = $request['faculty'] ?? 'N/A';
            $person->carrera = $request['career'] ?? 'N/A';
            $person->nivel = $request['level'] ?? 'N/A';
            $person->motivo = $request['reason'] ?? 'Matriculación';
            $person->save();
        }

        // 3. Crear el turno (Shift) vinculado por cédula
        $shift = new Shift();
        $shift->id_shift = (string) \Illuminate\Support\Str::uuid();
        $shift->cubicle_shift = $request['cubicle'];
        $shift->date_shift = $request['date'];
        $shift->start_shift = $request['start_time'];
        $shift->end_shift = $request['end_time'];
        $shift->person_shift = $person->cedula;
        $shift->status_shift = Shift::STATUS_OCCUPIED; // Marca el turno como ocupado inmediatamente
        $shift->save();

        return response()->json(['data' => $shift, 'message' => 'Turno creado con éxito']);
    }

    /**
     * Lista los turnos con filtros de cubículo y horario para la vista administrativa.
     */
    public function index(Request $request)
    {
        $query = Shift::join("cubiculos", "cubiculos.id", "=", "shifts.cubicle_shift")
            ->leftJoin("student_registrations", "student_registrations.cedula", "=", "shifts.person_shift")
            ->leftJoin('careers', 'careers.career_code', '=', 'student_registrations.plan_estudio')
            ->select(
                "shifts.id_shift as id",
                "shifts.date_shift",
                "shifts.start_shift as start_time",
                "shifts.end_shift as end_time",
                "cubiculos.nombre as cubicle_name",
                "cubiculos.enlace_o_ubicacion as meeting_link",
                "student_registrations.names as student_name",
                "student_registrations.cedula as student_dni",
                "student_registrations.correo_puce as student_email",
                "student_registrations.plan_estudio as plan_estudio",
                "careers.name as career_name",
                "shifts.status_shift as status"
            );

        // Filtro por cubículo
        if ($request->has('cubiculo_id')) {
            $query->where('cubiculos.id', $request->input('cubiculo_id'));
        }

        // Filtro por fechas del Horario Maestro
        if ($request->has('horario_id')) {
            $schedule = Schedule::with('days')->find($request->input('horario_id'));
            if ($schedule) {
                $scheduleDates = $schedule->days->pluck('date_day')->map(function ($date) {
                    return Carbon::parse($date)->format('Y-m-d');
                });
                $query->whereIn('shifts.date_shift', $scheduleDates);
            }
        }

        $shifts = $query->orderBy("shifts.date_shift", "asc")
                       ->orderBy("shifts.start_shift", "asc")
                       ->get();

        return view('admin.shifts.index', ['shifts' => $shifts]);
    }

    /**
     * Vista de atención de turnos por fecha (lista por día).
     * Filtra por áreas del usuario y cubículos asignados al usuario.
     */
    public function attention(Request $request)
    {
        $user = auth()->user();
        $selectedDate = $request->get('date', Carbon::today()->toDateString());
        $selectedDate = Carbon::parse($selectedDate)->toDateString();

        $misAreasIds = $user->operatingAreas->pluck('id');

        $shifts = Shift::with(['person', 'cubicle'])
            ->where('shifts.date_shift', $selectedDate)
            ->whereHas('cubicle', function ($q) use ($misAreasIds, $user) {
                $q->whereIn('operating_area_id', $misAreasIds)
                  ->where('user_id', $user->id);
            })
            ->orderBy('shifts.start_shift')
            ->get();

        return view('admin.shifts.attention', compact('shifts', 'selectedDate'));
    }

    /**
     * ✅ API CORREGIDA: Obtener turnos disponibles SOLO modalidad virtual
     */
    public function getShifts(Request $request, $fecha)
    {

        try {
            $fechaFormateada = Carbon::parse($fecha)->format('Y-m-d');

            // Validar que la fecha no sea pasada
            if (Carbon::parse($fechaFormateada)->isPast()) {
                return response()->json([
                    'success' => false,
                    'message' => 'No se pueden consultar turnos de fechas pasadas.',
                    'data' => []
                ]);
            }

        // Obtener plan_estudio del estudiante desde sesión
        $planEstudio = session('student_plan_estudio');

        // Buscar el operating_area_id que corresponde a ese plan_estudio
        $operatingAreaId = DB::table('careers')
            ->where('career_code', $planEstudio) // career_code = plan_estudio
            ->value('operating_area_id');

        $cedula = session('student_cedula');
        if ($cedula) {
            // Verificar si ya tiene turno para cualquier fecha
            $tieneTurno = Shift::where('person_shift', $cedula)
                ->where('status_shift', Shift::STATUS_OCCUPIED)
                ->exists();

            if ($tieneTurno) {
                return response()->json([
                    'success' => false,
                    'message' => 'Ya tienes un turno asignado. Debes cancelarlo primero.',
                    'data' => []
                ]);
            }
        }
        // Si no se encuentra, no mostrar turnos
        if (!$operatingAreaId) {
            return response()->json([
                'success' => true,
                'fecha_consulta' => $fechaFormateada,
                'data' => [],
                'total' => 0,
                'message' => 'No hay cubículos disponibles para tu carrera de estudios.'
            ]);
        }

            // Consultar turnos SOLO virtuales y disponibles
            $turnos = DB::table('shifts')
                ->join('cubiculos', 'cubiculos.id', '=', 'shifts.cubicle_shift')
                ->whereDate('shifts.date_shift', $fechaFormateada)
                ->where('date_shift', '>=', Carbon::today()) // Solo turnos de hoy y futuros
                ->where('shifts.status_shift', Shift::STATUS_AVAILABLE) // ✅ Solo disponibles
                ->where('cubiculos.tipo_atencion', 'virtual') // ✅ Solo virtuales
                ->whereNull('shifts.person_shift') // Asegurar que no esté ocupado
                ->where('cubiculos.operating_area_id', $operatingAreaId) // ← Cubiculos segun el area operativa
                ->select(
                    'shifts.id_shift',
                    'shifts.start_shift',
                    'shifts.end_shift',
                    'cubiculos.nombre as cubiculo',
                    'cubiculos.enlace_o_ubicacion as link'
                )
                ->orderBy('shifts.start_shift')
                ->get();

            return response()->json([
                'success' => true,
                'fecha_consulta' => $fechaFormateada,
                'data' => $turnos,
                'total' => $turnos->count()
            ]);

        } catch (\Exception $e) {
            Log::error('Error en getShifts: ' . $e->getMessage());

            return response()->json([
                'success' => false,
                'error' => 'Error al procesar la solicitud',
                'message' => $e->getMessage()
            ], 500);
        }
    }

    /**
     * Elimina un turno.
     */
    public function destroy($id)
    {
        try {
            $shift = Shift::where('id_shift', $id)->firstOrFail();
            $shift->delete();
            return redirect()->back()->with('success', 'Turno eliminado correctamente.');
        } catch (\Exception $e) {
            return redirect()->back()->with('error', 'Error al eliminar el turno.');
        }
    }
}
</file>

<file path="app/Http/Controllers/Admin/ShiftUnlockController.php">
<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use App\Models\StudentRegistration;
use App\Models\Shift;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\DB;

class ShiftUnlockController extends Controller
{
    public function __construct()
    {
        $this->middleware('can:desbloqueo.ver')->only(['index', 'searchForm', 'search']);
        $this->middleware('can:desbloqueo.ejecutar')->only('unlock');
    }

    /**
     * Verifica si el usuario autenticado es Super Admin.
     */
private function isSuperAdmin(): bool
{
    $userId = Auth::id();
    
    // Buscar el ID del rol 'Super Admin'
    $roleId = DB::table('roles')
        ->where('name', 'Super Admin')
        ->value('id');
    
    if (!$roleId) {
        return false;
    }
    
    // Verificar si el usuario tiene ese rol
    return DB::table('model_has_roles')
        ->where('role_id', $roleId)
        ->where('model_id', $userId)
        ->where('model_type', 'App\\Models\\User')
        ->exists();
}

    /**
     * Obtiene los IDs de las áreas operativas del operador autenticado.
     * Para Super Admin, retorna un array vacío (no aplica filtro).
     */
    private function getOperatorAreaIds(): array
    {
        if ($this->isSuperAdmin()) {
            return []; // Super Admin no tiene restricción de áreas
        }

        return DB::table('area_user')
            ->where('user_id', Auth::id())
            ->pluck('operating_area_id')
            ->toArray();
    }

    /**
     * Lista paginada de estudiantes bloqueados (turno pasado O estado final)
     * - Operadores: solo ven estudiantes de sus áreas.
     * - Super Admin: ve TODOS los estudiantes bloqueados.
     */
    public function index()
    {
        $areaIds = $this->getOperatorAreaIds();
        $isSuperAdmin = $this->isSuperAdmin();

        // Si es operador y no tiene áreas asignadas, no ve nada
        if (!$isSuperAdmin && empty($areaIds)) {
            $blockedStudents = collect();
            return view('admin.shift_unlock.index', compact('blockedStudents'));
        }

        // Consulta base: bloqueados por turno pasado
        $blockedByPast = StudentRegistration::withPastOccupiedShifts();

        // Consulta base: bloqueados por estado final (tomado = 3) y sin turno pasado ocupado
        $blockedByState = StudentRegistration::where('tomado', StudentRegistration::STUDENT_REBOOKED_FINAL)
            ->whereDoesntHave('shifts', function ($q) {
                $q->where('date_shift', '<', now())
                  ->where('status_shift', Shift::STATUS_OCCUPIED);
            });

        // Aplicar filtro de área SOLO si NO es Super Admin
        if (!$isSuperAdmin) {
            $blockedByPast = $blockedByPast->whereHas('career', function ($q) use ($areaIds) {
                $q->whereIn('operating_area_id', $areaIds);
            });

            $blockedByState = $blockedByState->whereHas('career', function ($q) use ($areaIds) {
                $q->whereIn('operating_area_id', $areaIds);
            });
        }

        // Ejecutar consultas
        $blockedByPast = $blockedByPast->orderBy('updated_at', 'desc')->get();
        $blockedByState = $blockedByState->orderBy('updated_at', 'desc')->get();

        // Unir colecciones
        $blockedStudents = $blockedByPast->merge($blockedByState)->unique('cedula');

        return view('admin.shift_unlock.index', compact('blockedStudents'));
    }

    /**
     * Muestra el formulario de búsqueda individual por cédula.
     */
    public function searchForm()
    {
        return view('admin.shift_unlock.search');
    }

    /**
     * Procesa la búsqueda por cédula.
     * - Operador: solo puede buscar estudiantes de sus áreas.
     * - Super Admin: puede buscar cualquier estudiante.
     */
    public function search(Request $request)
    {
        $request->validate([
            'cedula' => 'required|string|max:20',
        ]);

        $student = StudentRegistration::where('cedula', $request->cedula)->first();

        if (!$student) {
            return redirect()->back()->with('error', 'No se encontró ningún estudiante con esa cédula.');
        }

        // Solo aplicar filtro de área si NO es Super Admin
        if (!$this->isSuperAdmin()) {
            $areaIds = $this->getOperatorAreaIds();
            $careerAreaId = $student->career?->operating_area_id;

            if (!$careerAreaId || !in_array($careerAreaId, $areaIds)) {
                return redirect()->back()->with('error', 'No tiene permisos para gestionar este estudiante (área no asignada).');
            }
        }

        // Obtener turnos ocupados (activos)
        $occupiedShifts = Shift::where('person_shift', $student->cedula)
            ->where('status_shift', Shift::STATUS_OCCUPIED)
            ->orderBy('date_shift', 'desc')
            ->get();

        return view('admin.shift_unlock.result', [
            'student' => $student,
            'occupiedShifts' => $occupiedShifts,
        ]);
    }

    /**
     * Desbloquear estudiante.
     * - Operador: solo puede desbloquear estudiantes de sus áreas.
     * - Super Admin: puede desbloquear cualquier estudiante.
     */
    public function unlock($cedula)
    {
        $student = StudentRegistration::where('cedula', $cedula)->first();

        if (!$student) {
            return redirect()->back()->with('error', 'Estudiante no encontrado.');
        }

        // Solo aplicar filtro de área si NO es Super Admin
        if (!$this->isSuperAdmin()) {
            $areaIds = $this->getOperatorAreaIds();
            $careerAreaId = $student->career?->operating_area_id;

            if (!$careerAreaId || !in_array($careerAreaId, $areaIds)) {
                return redirect()->back()->with('error', 'No tiene permisos para desbloquear este estudiante (área no asignada).');
            }
        }

        // Liberar todos los turnos ocupados
        Shift::where('person_shift', $cedula)
            ->where('status_shift', Shift::STATUS_OCCUPIED)
            ->update([
                'person_shift' => null,
                'status_shift' => Shift::STATUS_AVAILABLE,
            ]);

        // Resetear estado del estudiante
        $student->tomado = StudentRegistration::STUDENT_CAN_TAKE_SHIFT;
        $student->save();

        return redirect()->route('shift_unlock.index')
            ->with('success', "Estudiante {$student->names} desbloqueado correctamente.");
    }
}
