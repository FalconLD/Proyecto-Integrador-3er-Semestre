<file path="app/Http/Controllers/Student/TokenLoginController.php">
<?php

namespace App\Http\Controllers\Student;

use App\Http\Controllers\Controller;
use Illuminate\Support\Facades\Http;
use Illuminate\Http\Request;
use App\Models\StudentRegistration;

class TokenLoginController extends Controller
{
    public function showLoginForm()
    {
        return view('auth.token-login');
    }


    public function login(Request $request)
    {
        $request->validate([
            'token' => 'required|string',
        ]);

        // 1️⃣ Verificar token PUCE
        $url = "https://www.puce.edu.ec/intranet/servicios/datos/turneros/token/" . $request->token;
        $response = Http::get($url);

        if ($response->failed()) {
            return back()->withErrors(['token' => 'No se pudo verificar el token.']);
        }

        $data = $response->json();

        if (!isset($data['status']) || $data['status'] !== 'success') {
            return back()->withErrors(['token' => 'Token inválido o expirado.']);
        }

        $info = $data['data'];
        $facultad = $info['facultad'] ?? 'No especificada';
        $carrera = $info['carrera'] ?? 'No especificada';

        // 2️⃣ Crear o actualizar el estudiante
        $student = StudentRegistration::updateOrCreate(
            ['cedula' => $info['cedula']],
            [
                'names' => $info['nombre'],
                'correo_puce' => $info['usuario'] . '@puce.edu.ec',
                'facultad' => null,
                'carrera' => null,
                'nivel' => null,
                'banner_id'    => $info['idbanner'],
                'plan_estudio' => $info['plan_estudio'] ?? null,
                'nivel_instruccion' => null,
                'edad' => null,
                'fecha_nacimiento' => null,
                'telefono' => null,
                'direccion' => null,
                'motivo' => null,
                'acepta_terminos' => false,
            ]
        );

        // 3️⃣ Guardar datos básicos del estudiante en la sesión
        session()->put([
            'student_logged_in' => true,
            'student_id' => $student->id,
            'student_name' => $student->names,
            'student_cedula' => $student->cedula,
            'student_correo' => $info['usuario'] . '@puce.edu.ec',
            'student_facultad'  => $facultad, // <--- Agregado para mostrarse al estudiante
            'student_carrera'   => $carrera,  // <--- Agregado para mostrarse al estudiante
        ]);

        // 4️⃣ Redirigir al formulario principal de estudiantes
        return redirect()->route('student.personal');
    }

    public function logout(Request $request)
    {
        $request->session()->forget([
            'student_logged_in',
            'student_id',
            'student_name',
            'student_cedula'
        ]);

        return redirect()->route('token.login.form');
    }

    public function loginWithToken($token)
    {
        // 1. URL del servicio remoto
        $url = "https://www.puce.edu.ec/intranet/servicios/datos/turneros/token/{$token}";
        $response = Http::get($url);

        if ($response->failed() || $response->json('status') !== 'success') {
            return redirect()->route('student.token.error')
                ->withErrors(['error' => 'Token inválido o expirado.']);
        }

        // 2. Extraer datos
        $data = $response->json('data');
        $cedula = $data['cedula'] ?? null;
        $nombre = $data['nombre'] ?? null;
        $usuario = $data['usuario'] ?? null;
        $idBanner = $data['idbanner'] ?? null;
        $planEstudio = $data['plan_estudio'] ?? null;
        $facultad = $data['facultad'] ?? null;
        $carrera = $data['carrera'] ?? null;

        if (!$cedula) {
            return redirect()->route('student.token.error')
                ->withErrors(['error' => 'El token no contiene una cédula válida.']);
        }

        // 🔹 NUEVO: Verificar si hay sesión activa de OTRO estudiante
        if (session('student_logged_in') && session('student_cedula') !== $cedula) {
            // Hay sesión activa de otro estudiante → mostrar error específico
            return redirect()->route('student.token.error')
                ->withErrors([
                    'error' => 'Ya hay una sesión activa con otro estudiante. Cierre la sesión actual antes de continuar.',
                    'detalle' => "Intento de acceso con cédula: {$cedula} mientras hay sesión activa para: " . session('student_cedula')
                ]);
        }

        // 3. Buscar estudiante existente
        $student = StudentRegistration::where('cedula', $cedula)->first();

        // 🔹 CORREGIDO: Limpiar sesión previa solo si es el mismo estudiante
        if (!session('student_logged_in') || session('student_cedula') === $cedula) {
            session()->forget('student_personal_completed');
        }

        if ($student) {
            // ✅ Actualizar solo campos académicos (NO datos personales)
            $student->update([
                'names' => $nombre,
                'banner_id' => $idBanner,
                'plan_estudio' => $planEstudio,
                'correo_puce' => $usuario ? "{$usuario}@puce.edu.ec" : $student->correo_puce,
                'facultad' => $facultad ?? $student->facultad,
                'carrera' => $carrera ?? $student->carrera,
            ]);

            // 🔹 VERIFICAR: ¿Ya completó datos personales?
            if ($student->telefono && $student->direccion && $student->acepta_terminos) {
                // Ya completó → redirigir a agendamiento
                session([
                    'student_logged_in' => true,
                    'student_id' => $student->id,
                    'student_personal_completed' => true,
                    'student_cedula' => $student->cedula,
                    'student_name' => $student->names,
                    'student_correo' => $usuario ? "{$usuario}@puce.edu.ec" : null,
                    'student_banner_id' => $idBanner,
                    'student_plan_estudio' => $planEstudio,
                    'student_facultad' => $facultad,
                    'student_carrera' => $carrera,
                ]);

                return redirect()->route('student.agendamiento')
                    ->with('info', 'Bienvenido nuevamente. Puede agendar un turno.');
            }
        } else {
            // Crear nuevo estudiante
            $student = StudentRegistration::create([
                'cedula' => $cedula,
                'names' => $nombre,
                'banner_id' => $idBanner,
                'plan_estudio' => $planEstudio,
                'correo_puce' => $usuario ? "{$usuario}@puce.edu.ec" : null,
                'facultad' => $facultad,
                'carrera' => $carrera,
                'acepta_terminos' => false,
                'tomado' => StudentRegistration::STUDENT_CAN_TAKE_SHIFT,
            ]);
        }

        // 🔹 Para estudiantes NUEVOS o que NO completaron datos → ir a personal
        session([
            'student_logged_in' => true,
            'student_id' => $student->id,
            'student_personal_completed' => false,
            'student_cedula' => $student->cedula,
            'student_name' => $student->names,
            'student_correo' => $usuario ? "{$usuario}@puce.edu.ec" : null,
            'student_banner_id' => $idBanner,
            'student_plan_estudio' => $planEstudio,
            'student_facultad' => $facultad,
            'student_carrera' => $carrera,
        ]);

        return redirect()->route('student.personal')
            ->with('info', 'Complete sus datos personales para continuar.');
    }
}
</file>

