    // --- Cubículos: usuario → áreas (select #user_id y #operating_area_id) ---
    if (typeof $ !== 'undefined') {
        var userSelect = $('#user_id');
        var areaSelect = $('#operating_area_id');
        if (userSelect.length && areaSelect.length) {
            var currentAreaId = areaSelect.data('current-area') || areaSelect.attr('data-current-area') || '';
            function fillAreas() {
                var opt = userSelect.find('option:selected');
                var areas = opt.data('areas');
                areaSelect.empty().append('<option value="">-- Seleccionar Área --</option>');
                if (areas && areas.length) {
                    areas.forEach(function (a) {
                        var sel = (String(a.id) === String(currentAreaId)) ? ' selected' : '';
                        areaSelect.append('<option value="' + a.id + '"' + sel + '>' + a.name + '</option>');
                    });
                } else if (userSelect.val()) {
                    areaSelect.append('<option value="" disabled>Sin áreas asignadas</option>');
                }
            }
            fillAreas();
            userSelect.on('change', function () {
                currentAreaId = '';
                fillAreas();
            });
        }
    }

    // --- Breaks dinámicos (schedules create/edit) ---
    (function () {
        var container = document.getElementById('breaksContainer');
        if (!container) return;
        var addBtn = document.getElementById('addBreak') || container.querySelector('[data-add-break]');
        var templateId = container.getAttribute('data-break-template') || 'breakRowTemplate';
        var templateEl = document.getElementById(templateId);
        if (!addBtn || !templateEl) return;
        addBtn.addEventListener('click', function () {
            var index = container.querySelectorAll('.break-row').length;
            var html = templateEl.innerHTML.trim().replace(/__INDEX__/g, index);
            container.insertAdjacentHTML('beforeend', html);
        });
        container.addEventListener('click', function (e) {
            if (e.target.closest('.btn-remove-break')) {
                var row = e.target.closest('.break-row');
                if (row) row.remove();
            }
        });
    })();

    // --- Validación solo dígitos (data-input-digits, opcional data-max-length) ---
    document.querySelectorAll('[data-input-digits]').forEach(function (input) {
        var maxLen = input.getAttribute('data-max-length');
        input.addEventListener('keydown', function (e) {
            if (['Backspace', 'Tab', 'Delete', 'ArrowLeft', 'ArrowRight'].indexOf(e.key) !== -1) return;
            if (!/^[0-9]$/.test(e.key)) e.preventDefault();
        });
        input.addEventListener('input', function () {
            this.value = this.value.replace(/[^0-9]/g, '');
            if (maxLen && this.value.length > parseInt(maxLen, 10)) {
                this.value = this.value.slice(0, parseInt(maxLen, 10));
            }
        });
    });

    // --- Toggle mostrar contraseña (data-toggle-password + data-target) ---
    document.querySelectorAll('[data-toggle-password]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var target = this.getAttribute('data-target');
            var input = target ? document.querySelector(target) : null;
            if (!input) return;
            var icon = this.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                if (icon) { icon.classList.remove('fa-eye'); icon.classList.add('fa-eye-slash'); }
            } else {
                input.type = 'password';
                if (icon) { icon.classList.remove('fa-eye-slash'); icon.classList.add('fa-eye'); }
            }
        });
    });
});
