<file path="tests/Feature/StudentTokenFlowTest.php">
<?php

namespace Tests\Feature;

use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Support\Facades\Http;
use Tests\TestCase;

/**
 * Pruebas del flujo de login por token (PUCE).
 *
 * Para la prueba con API real: definir EXAMPLE_TOKEN con un token válido.
 * Si EXAMPLE_TOKEN está vacío, esa prueba se omite y la terminal lo indica.
 * API: https://www.puce.edu.ec/intranet/servicios/datos/turneros/token/{token}
 */
class StudentTokenFlowTest extends TestCase
{
    use RefreshDatabase;

    /**
     * Token para probar contra el API real de PUCE.
     * Dejar vacío ('') para omitir la prueba y que se indique en terminal.
     * Poner un token válido (ej. 82c4b76f2b3340dee656eb79264f50b8) para ejecutarla.
     */
    private const EXAMPLE_TOKEN = '82c4b76f2b3340dee656eb79264f50b8';

    /** @test */
    public function post_registro_with_invalid_token_redirects_back_with_errors(): void
    {
        Http::fake([
            'www.puce.edu.ec/*' => Http::response(['status' => 'error', 'message' => 'Invalid token'], 200),
        ]);

        $response = $this->post(route('token.login'), [
            'token' => 'invalid-token-123',
            '_token' => csrf_token(),
        ]);

        $response->assertRedirect();
        $response->assertSessionHasErrors('token');
    }

    /**
     * Prueba con token real: llama al API de PUCE y valida redirect y sesión.
     * Si EXAMPLE_TOKEN está vacío, se omite y se muestra mensaje en terminal.
     * @test
     */
    public function post_registro_with_valid_token_redirects_to_student_personal(): void
    {
        if (self::EXAMPLE_TOKEN === '') {
            $this->markTestSkipped(
                'Debe registrarse un token válido para ejecutar esta prueba. ' .
                'Edite EXAMPLE_TOKEN en ' . __FILE__ . ' o use un token de ' .
                'https://www.puce.edu.ec/intranet/servicios/datos/turneros/token/'
            );
        }

        // Sin Http::fake: la app llama al API real de PUCE con EXAMPLE_TOKEN
        $response = $this->post(route('token.login'), [
            'token' => self::EXAMPLE_TOKEN,
            '_token' => csrf_token(),
        ]);

        $response->assertRedirect(route('student.personal'));
        $this->assertTrue(session()->has('student_logged_in'));
        $this->assertNotEmpty(session('student_cedula'));
    }

    /** @test */
    public function post_registro_without_token_fails_validation(): void
    {
        $response = $this->post(route('token.login'), [
            'token' => '',
            '_token' => csrf_token(),
        ]);

        $response->assertSessionHasErrors('token');
    }
}
</file>

