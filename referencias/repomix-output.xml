window.initDaysFlatpickr = function (options) {
    var pickerEl = document.getElementById('datepicker');
    if (!pickerEl || typeof flatpickr === 'undefined') return null;
    var opts = options || {};
    var defaultDates = opts.defaultDates || [];
    var hiddenContainer = document.getElementById('hidden-dates');
    if (!hiddenContainer) return null;
    return flatpickr('#datepicker', {
        locale: 'es',
        mode: 'multiple',
        dateFormat: 'Y-m-d',
        minDate: 'today',
        inline: true,
        showMonths: 2,
        defaultDate: defaultDates,
        firstDayOfWeek: 1,
        disable: [function (date) { return date.getDay() === 0 || date.getDay() === 6; }],
        onChange: function (selectedDates, dateStr, instance) {
            hiddenContainer.innerHTML = '';
            selectedDates.forEach(function (date) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'dates[]';
                input.value = instance.formatDate(date, 'Y-m-d');
                hiddenContainer.appendChild(input);
            });
        }
    });
};

