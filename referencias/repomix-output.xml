<file path="database/seeders/AreaAssignmentSeeder.php">
<?php

namespace Database\Seeders;

use Illuminate\Database\Seeder;
use App\Models\User;
use App\Models\OperatingArea;
use Illuminate\Support\Facades\File;

class AreaAssignmentSeeder extends Seeder
{
    public function run(): void
    {
        $json = File::get(database_path('data/area_assignments.json'));
        $assignments = json_decode($json, true);

        // Agrupamos por email para hacer una sola actualización por usuario
        $grouped = collect($assignments)->groupBy('email');

        foreach ($grouped as $email => $items) {
            $user = User::where('email', $email)->first();
            
            if ($user) {
                // Obtenemos los IDs de las áreas basándonos en los nombres del JSON
                $areaIds = OperatingArea::whereIn('name', $items->pluck('area_name'))
                            ->pluck('id')
                            ->toArray();

                // Asociamos las áreas al usuario sin borrar las anteriores (syncWithoutDetaching)
                // O usamos sync() si queremos que el Excel sea la única fuente de verdad
                $user->operatingAreas()->sync($areaIds);
                
                $this->command->info("Asignadas " . count($areaIds) . " áreas al usuario: $email");
            } else {
                $this->command->warn("Usuario no encontrado: $email");
            }
        }
    }
}
</file>

