<file path="database/factories/StudentRegistrationFactory.php">
<?php

namespace Database\Factories;

use App\Models\StudentRegistration;
use Illuminate\Database\Eloquent\Factories\Factory;

/**
 * @extends \Illuminate\Database\Eloquent\Factories\Factory<\App\Models\StudentRegistration>
 */
class StudentRegistrationFactory extends Factory
{
    protected $model = StudentRegistration::class;

    /**
     * Define the model's default state.
     *
     * @return array<string, mixed>
     */
    public function definition(): array
    {
        $cedula = $this->faker->unique()->numerify('##########');
        $user = strtolower($this->faker->userName());

        return [
            'names' => $this->faker->name(),
            'cedula' => $cedula,
            'banner_id' => $this->faker->optional()->numerify('########'),
            'correo_puce' => $user . '@puce.edu.ec',
            'telefono' => $this->faker->numerify('09########'),
            'direccion' => $this->faker->address(),
            'facultad' => $this->faker->optional()->company(),
            'carrera' => $this->faker->optional()->jobTitle(),
            'nivel' => $this->faker->optional()->randomElement(['1ro', '2do', '3ro']),
            'plan_estudio' => $this->faker->optional()->randomElement(['Plan 2022', 'Plan 2018']),
            'motivo' => $this->faker->optional()->sentence(),
            'nivel_instruccion' => 'grado',
            'acepta_terminos' => true,
            'tomado' => StudentRegistration::STUDENT_CAN_TAKE_SHIFT,
        ];
    }

    /** Estado: estudiante con turno asignado (puede cancelar). */
    public function withShift(): static
    {
        return $this->state(fn (array $attributes) => [
            'tomado' => StudentRegistration::STUDENT_HAS_SHIFT,
        ]);
    }

    /** Estado: eliminó turno, puede reagendar. */
    public function canRebook(): static
    {
        return $this->state(fn (array $attributes) => [
            'tomado' => StudentRegistration::STUDENT_DELETED_CAN_REBOOK,
        ]);
    }

    /** Estado: turno final (no puede reagendar). */
    public function finalShift(): static
    {
        return $this->state(fn (array $attributes) => [
            'tomado' => StudentRegistration::STUDENT_REBOOKED_FINAL,
        ]);
    }
}
