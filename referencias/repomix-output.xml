<?php

namespace Tests\Unit;

use App\Models\Shift;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Tests\TestCase;

class ShiftModelTest extends TestCase
{
    use RefreshDatabase;

    /** @test */
    public function status_constants_are_defined(): void
    {
        $this->assertSame(0, Shift::STATUS_OCCUPIED);
        $this->assertSame(1, Shift::STATUS_AVAILABLE);
        $this->assertSame(2, Shift::STATUS_CANCELLED);
    }

    /** @test */
    public function scope_available_filters_by_available_status(): void
    {
        // Requires shifts table and at least one record; we only assert the scope builds correctly
