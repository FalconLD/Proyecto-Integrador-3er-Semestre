<file path="app/Http/Controllers/Admin/AttentionController.php">
<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use App\Models\Shift;
use App\Models\Cubiculo;
use Carbon\Carbon;

class AttentionController extends Controller
{
    public function index()
    {
        $user = auth()->user();
        $userId = $user->id;
        $misAreasIds = $user->operatingAreas->pluck('id');

        // Cubículos del usuario (mismo criterio que abajo) para asignar color fijo por cubículo
        $cubiculos = Cubiculo::whereIn('operating_area_id', $misAreasIds)
            ->where('user_id', $userId)
            ->orderBy('id')
            ->get();

        // Paleta de colores alineada con AdminLTE/Bootstrap (sin azul marino)
        $palette = ['#007bff', '#28a745', '#17a2b8', '#ffc107', '#dc3545', '#6f42c1', '#fd7e14', '#20c997'];
        $cubicleColors = [];
        foreach ($cubiculos as $i => $c) {
            $cubicleColors[$c->id] = $palette[$i % count($palette)];
        }

        $shifts = Shift::join("cubiculos", "cubiculos.id", "=", "shifts.cubicle_shift")
            ->leftJoin("student_registrations", "student_registrations.cedula", "=", "shifts.person_shift")
            ->select(
                "shifts.id_shift",
                "shifts.date_shift",
                "shifts.start_shift",
                "shifts.end_shift",
                "shifts.status_shift",
                "shifts.cubicle_shift as cubicle_id",
                "cubiculos.nombre as cubicle_name",
                "cubiculos.user_id as cubicle_user_id",
                "student_registrations.names as student_name",
                "student_registrations.banner_id as banner_id"
            )
            ->whereIn('cubiculos.operating_area_id', $misAreasIds)
            ->where('cubiculos.user_id', $userId)
            ->get();

        $calendarEvents = $shifts->map(function ($shift) use ($cubicleColors) {
            $estaOcupado = ($shift->status_shift == 0);
            $startTime = $this->formatearHora($shift->start_shift);
            $endTime = $this->formatearHora($shift->end_shift);

            if ($estaOcupado && $shift->student_name) {
                $titulo = $shift->cubicle_name . ' — ' . $shift->student_name;
            } else {
                $titulo = $shift->cubicle_name . ' — Libre';
            }

            if ($estaOcupado) {
                $color = $cubicleColors[$shift->cubicle_id] ?? '#6c757d';
            } else {
                $color = '#adb5bd';
            }
            $borderColor = $color;

            return [
                'id'               => $shift->id_shift,
                'title'            => $titulo,
                'start'            => $shift->date_shift . 'T' . $startTime,
                'end'              => $shift->date_shift . 'T' . $endTime,
                'backgroundColor' => $color,
                'borderColor'      => $borderColor,
                'extendedProps'    => [
                    'hora_inicio'   => $startTime,
                    'hora_fin'      => $endTime,
                    'estado'        => $estaOcupado ? 'ocupado' : 'libre',
                    'banner_id'     => $shift->banner_id ?? null,
                    'student_name'  => $shift->student_name ?? null,
                ],
            ];
        })->toArray();

        return view('admin.attention.index', compact('calendarEvents', 'cubiculos', 'cubicleColors'));
    }

    private function formatearHora($hora)
    {
        if (empty($hora)) {
            return '00:00';
        }
        // Eliminar espacios en blanco
        $hora = trim($hora);

        if (strpos($hora, ':') !== false) {
            $partes = explode(':', $hora);
            // Asegurar dos dígitos para horas y minutos
            $horaPart = str_pad($partes[0], 2, '0', STR_PAD_LEFT);
            $minutoPart = isset($partes[1]) ? str_pad($partes[1], 2, '0', STR_PAD_LEFT) : '00';
            return $horaPart . ':' . $minutoPart;
        }

        // Si es solo un número, tratar como hora
        if (is_numeric($hora)) {
            if ($hora > 24) {
                // Convertir a formato de hora (ej: 1300 -> 13:00)
                $horaStr = str_pad($hora, 4, '0', STR_PAD_LEFT);
                return substr($horaStr, 0, 2) . ':' . substr($horaStr, 2, 2);
            }
            // Caso normal: solo la hora
            return str_pad($hora, 2, '0', STR_PAD_LEFT) . ':00';
        }
        // Si no coincide con ningún formato conocido, devolver 00:00
        return '00:00';
    }
}
