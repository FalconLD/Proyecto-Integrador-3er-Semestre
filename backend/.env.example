DB_SERVER=your-azure-sql-server.database.windows.net
DB_PORT=1433
DB_USER=tu_usuario_sql
DB_PASSWORD=tu_password_sql
DB_NAME=h2o-db

# MongoDB connection (local o Atlas). Ejemplo Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/h2o-db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/h2o-db

# Puerto del servidor Express
PORT=3001

# JWT secret
JWT_SECRET=una_clave_secreta_para_jwt
# Azure SQL Database - Proyecto Integrador H2O
PORT=3001
NODE_ENV=development

# Conexión Azure SQL (sql-h2o-integrador-lf)
DB_SERVER=sql-h2o-integrador-lf.database.windows.net
DB_NAME=h2o-db
DB_USER=sqladmin
DB_PASSWORD=TU_CONTRASEÑA_AQUI
DB_PORT=1433

# MongoDB (local o Atlas)
MONGODB_URI=mongodb://localhost:27017/h2o-db
