# Copiar a .env y completar valores. No subir .env al repositorio.

# Azure SQL Database
DB_SERVER=your-server.database.windows.net
DB_PORT=1433
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=h2o-db

# MongoDB (local o Atlas)
MONGODB_URI=mongodb://localhost:27017/h2o-db

# Servidor Express
PORT=3001

# Obligatorio en producción
JWT_SECRET=una_clave_secreta_larga_y_aleatoria

# Opcional
NODE_ENV=development
